+
+void GLTextureUploader_BGRA8Swizzle::UploadRect(void* d, UnrealMipmap* mip, int x, int y, int w, int h, TextureColor* palette, bool masked)
+{
+	int pitch = mip->Width * 4;
+	const uint8_t* src = mip->Data.data() + x * 4 + y * pitch;
+	uint8_t* dst = (uint8_t*)d;
+	for (int i = 0; i < h; i++)
+	{
+		for (int j = 0; j < w; j++)
+		{
+			dst[0] = src[j * 4 + 2];
+			dst[1] = src[j * 4 + 1];
+			dst[2] = src[j * 4 + 0];
+			dst[3] = src[j * 4 + 3];
+			dst += 4;
+		}
+		src += pitch;
+	}
+}
