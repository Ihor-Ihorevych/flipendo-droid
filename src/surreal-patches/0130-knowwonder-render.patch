+static std::string ToGlslEs300(const std::string& source, bool vertex)
+{
+	std::string out;
+	size_t pos = 0;
+	while (pos < source.size())
+	{
+		size_t end = source.find('\n', pos);
+		if (end == std::string::npos)
+			end = source.size();
+		std::string line = source.substr(pos, end - pos);
+		pos = end + 1;
+
+		if (line.find("textureBinds") != std::string::npos && line.find(" in ") != std::string::npos)
+			continue;
+		size_t layout = line.find("layout(");
+		if (layout != std::string::npos)
+		{
+			size_t close = line.find(')', layout);
+			std::string qualifier = line.substr(layout, close - layout + 1);
+			bool binding = qualifier.find("binding") != std::string::npos;
+			bool varying = qualifier.find("location") != std::string::npos &&
