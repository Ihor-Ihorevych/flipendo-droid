+bool VulkanRenderDevice::RecreateSurface()
+{
+	vkDeviceWaitIdle(Device->device);
+	VkInstance instance = Device->Surface->Instance->Instance;
+	VkSurfaceKHR fresh = Viewport->CreateVulkanSurface(instance);
+	if (fresh == VK_NULL_HANDLE)
+		return false; // no native window right now; the next frame tries again
+	vkDestroySurfaceKHR(instance, Device->Surface->Surface, nullptr);
+	Device->Surface->Surface = fresh;
+	LogMessage("Vulkan surface recreated (the window was recreated, e.g. the app came back from the background)");
+	return true;
+}
