+		int sy = y + py;
+		for (int px = 0; px < w; px++)
+		{
+			int sx = x + px;
+			int block = (sy / 4) * blocksPerRow + (sx / 4);
+			if (block != decoded)
+			{
+				size_t offset = (size_t)block * bytesPerBlock;
+				memset(rgba, 0, sizeof(rgba));
+				if (offset + bytesPerBlock <= mip->Data.size())
