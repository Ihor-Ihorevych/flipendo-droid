flipendo: Harry Potter 2: its sound objects' extra fields and XA sounds, no IpDrv package, actors' tick parents

diff --git a/SurrealEngine/Packages/Engine/Resources/Level/ULevel.cpp b/SurrealEngine/Packages/Engine/Resources/Level/ULevel.cpp
index 5088612a..7011ea88 100644
--- a/SurrealEngine/Packages/Engine/Resources/Level/ULevel.cpp
+++ b/SurrealEngine/Packages/Engine/Resources/Level/ULevel.cpp
@@ -7,6 +7,7 @@
 #include "Packages/Engine/Resources/Level/UModel.h"
 #include "Engine.h"
 #include "VM/ScriptCall.h"
+#include "HP2.h"
 
 ULevel::ULevel(NameString name, UClass* base, ObjectFlags flags) : ULevelBase(name, base, flags)
 {
@@ -64,8 +65,17 @@ void ULevel::TickActor(float elapsed, UActor* actor)
 	if (!actor)
 		return;
 
+	if (engine->LaunchInfo.IsHarryPotter2())
+	{
+		// Harry Potter 2: its TickParent and TickParent2 tick first, then its owner (src/hp2/HP2Tick.cpp)
+		if (!actor->bDeleteMe())
+		{
+			for (int i = 0; i < 3; i++)
+				TickActor(elapsed, HP2::TickBefore(actor, i));
+		}
+	}
 	// If we have an owner, tick it first
-	if (!actor->bDeleteMe() && actor->Owner())
+	else if (!actor->bDeleteMe() && actor->Owner())
 	{
 		TickActor(elapsed, actor->Owner());
 	}
@@ -77,6 +87,10 @@ void ULevel::TickActor(float elapsed, UActor* actor)
 	// Mark actor as ticked
 	actor->bTicked() = ticked;
 
+	// Harry Potter 2's special pause stops every actor but the ones that may move in it (src/hp2/HP2Tick.cpp)
+	if (engine->LaunchInfo.IsHarryPotter2() && !HP2::SpecialPauseTick(actor, elapsed))
+		return;
+
 	// Tick the actor for this turn
 	actor->Tick(elapsed);
 
diff --git a/SurrealEngine/Packages/Engine/Resources/USound.h b/SurrealEngine/Packages/Engine/Resources/USound.h
index c937674f..4db521f2 100644
--- a/SurrealEngine/Packages/Engine/Resources/USound.h
+++ b/SurrealEngine/Packages/Engine/Resources/USound.h
@@ -32,6 +32,11 @@ public:
 	NameString Format;
 	Array<uint8_t> Data;
 
+	// Harry Potter 2: flags, five more ints (some only in later package versions) and, with flag 0x80, a second data block
+	uint32_t HP2Flags = 0;
+	uint32_t HP2Values[5] = {};
+	Array<uint8_t> HP2ExtraData;
+
 	Array<float> samples;
 	float duration = 0.0f;
 	int frequency = 0;
