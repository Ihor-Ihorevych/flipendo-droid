+void ALSoundSource::SetPaused(bool paused)
+{
+	ALint state;
+	alGetSourcei(id, AL_SOURCE_STATE, &state);
+	if (paused && state == AL_PLAYING)
+		alSourcePause(id);
+	else if (!paused && state == AL_PAUSED)
+		alSourcePlay(id);
+}
