+fs::path File::find_ignoring_case(const fs::path& path)
+{
+	std::error_code ec;
+	if (path.empty() || fs::exists(path, ec))
+		return path;
+
+	fs::path result;
+	bool matching = true;
+	for (const fs::path& part : path)
+	{
+		fs::path next = result / part;
+		if (matching && !result.empty() && !fs::exists(next, ec))
+		{
+			matching = false;
+			for (const auto& entry : fs::directory_iterator(result, ec))
+			{
+				if (StrTools::equals_ignore_case(entry.path().filename().string(), part.string()))
+				{
+					next = entry.path();
+					matching = true;
+					break;
+				}
+			}
+		}
+		result = next;
+	}
+	return result;
+}
