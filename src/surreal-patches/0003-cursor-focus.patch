+#ifdef __ANDROID__
+// Whether the Android surface exists right now (defined by the app, android_main.cpp; absent in other programs)
+extern "C" __attribute__((weak)) bool FlipendoAndroidSurfaceAlive();
+#endif
+
+#ifdef __ANDROID__
+// Android: an OpenGL ES 3.0 (or newer) context, set before the window is made (SDL chooses the EGL config then). No depth or stencil in
+// the window: the renderer draws into its own framebuffers and only copies the result to the window.
+static void SetAndroidGLAttributes()
+{
+	SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+	SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+	SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0); // ES 3.0 at least; drivers give their newest compatible version
+	SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
+	SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
+	SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
+	SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 0);
+	SDL_GL_SetAttribute(SDL_GL_STENCIL_SIZE, 0);
+}
+#endif
+
