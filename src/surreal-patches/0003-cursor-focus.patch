 		flags |= SDL_WINDOW_VULKAN;
 	else if (renderAPI == RenderAPI::OpenGL)
+	{
 		flags |= SDL_WINDOW_OPENGL;
+#ifdef __ANDROID__
+		SetAndroidGLAttributes();
+#endif
+	}
 #if defined(__APPLE__)
 	else if (renderAPI == RenderAPI::Metal)
 		flags |= SDL_WINDOW_METAL;
