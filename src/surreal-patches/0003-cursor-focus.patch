+#ifdef __ANDROID__
+	// Android: between the surface being destroyed (the app goes to the background) and a new one, the window has no native
+	// window (SDL keeps a stale pointer in the window property); a Vulkan surface made then crashed in the loader. The app
+	// (android_main.cpp) tracks the surface; the renderer skips frames until one exists again.
+	if (FlipendoAndroidSurfaceAlive && !FlipendoAndroidSurfaceAlive())
