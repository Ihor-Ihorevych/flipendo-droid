+			if (offset + bytesPerBlock <= mip->Data.size())
+				BCDecodeBlock(Kind, mip->Data.data() + offset, rgba);
+			int i = (sy & 3) * 4 + (sx & 3);
+			memcpy(dst + ((size_t)py * w + px) * 4, rgba + i * 4, 4);
+		}
+	}
+}
