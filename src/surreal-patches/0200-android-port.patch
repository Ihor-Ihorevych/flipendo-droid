+
+void GLTextureUploader_BCDecode::UploadRect(void* d, UnrealMipmap* mip, int x, int y, int w, int h, TextureColor* palette, bool masked)
+{
+	int bytesPerBlock = (Kind == 1) ? 8 : 16;
+	int blocksPerRow = (mip->Width + 3) / 4;
+	uint8_t* dst = (uint8_t*)d;
+	uint8_t rgba[64];
+	int decoded = -1;
+	for (int py = 0; py < h; py++)
+	{
+		int sy = y + py;
+		for (int px = 0; px < w; px++)
+		{
+			int sx = x + px;
+			int block = (sy / 4) * blocksPerRow + (sx / 4);
+			if (block != decoded)
+			{
+				size_t offset = (size_t)block * bytesPerBlock;
+				memset(rgba, 0, sizeof(rgba));
+				if (offset + bytesPerBlock <= mip->Data.size())
+					BCDecodeBlock(Kind, mip->Data.data() + offset, rgba);
+				decoded = block;
+			}
+			int i = (sy & 3) * 4 + (sx & 3);
+			memcpy(dst + ((size_t)py * w + px) * 4, rgba + i * 4, 4);
+		}
+	}
+}
+
+int GLTextureUploader_BGRA8Swizzle::GetUploadSize(int x, int y, int w, int h)
+{
+	return w * h * 4;
+}
+
+void GLTextureUploader_BGRA8Swizzle::UploadRect(void* d, UnrealMipmap* mip, int x, int y, int w, int h, TextureColor* palette, bool masked)
+{
+	int pitch = mip->Width * 4;
+	const uint8_t* src = mip->Data.data() + x * 4 + y * pitch;
+	uint8_t* dst = (uint8_t*)d;
+	for (int i = 0; i < h; i++)
+	{
+		for (int j = 0; j < w; j++)
+		{
+			dst[0] = src[j * 4 + 2];
+			dst[1] = src[j * 4 + 1];
+			dst[2] = src[j * 4 + 0];
+			dst[3] = src[j * 4 + 3];
+			dst += 4;
+		}
+		src += pitch;
+	}
+}
