+// Not Bindless: the textures of a draw are fixed per batch, so a change of textures ends the batch.
+void VulkanRenderDevice::SetFixedTextures(uint32_t PolyFlags, CachedTexture* tex, bool clamp, CachedTexture* macrotex, CachedTexture* detailtex, CachedTexture* lightmap)
+{
+	uint32_t samplermode = 0;
+	if (PolyFlags & PF_NoSmooth) samplermode |= 1;
+	if (clamp) samplermode |= 2;
+
+	CachedTexture* textures[4] = { tex, macrotex, detailtex, lightmap };
+	FixedTextureKey key;
+	for (int i = 0; i < 4; i++)
+	{
+		VulkanImageView* view = textures[i] ? textures[i]->imageView.get() : Textures->NullTextureView.get();
+		key.view[i] = view->view;
+		key.sampler[i] = Samplers->Samplers[i == 0 ? samplermode : 0]->sampler; // as the bindless path: only the texture itself picks its sampler
+	}
+
+	if (key != Batch.Fixed)
+	{
+		if (DescriptorSets->FixedTextureSetsFull())
+		{
+			FlushDrawBatchAndWait(); // submits and waits, then the sets can be recycled
+			DescriptorSets->ResetFixedTextureSets();
+		}
+		else
+		{
+			DrawBatch(Commands->GetDrawCommands());
+		}
+		Batch.Fixed = key;
+	}
