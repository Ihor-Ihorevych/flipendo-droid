+			result += (char)(0x80 | (c & 0x3f));
+		}
+		else if (c < 0x10000)
+		{
+			result += (char)(0xe0 | (c >> 12));
+			result += (char)(0x80 | ((c >> 6) & 0x3f));
+			result += (char)(0x80 | (c & 0x3f));
+		}
+		else
+		{
+			result += (char)(0xf0 | (c >> 18));
+			result += (char)(0x80 | ((c >> 12) & 0x3f));
+			result += (char)(0x80 | ((c >> 6) & 0x3f));
+			result += (char)(0x80 | (c & 0x3f));
+		}
+	}
+	return result;
 }
 
 std::wstring to_utf16(const std::string& str)
 {
-	Exception::Throw("to_utf16 not implemented on unix");
+	std::wstring result;
+	result.reserve(str.size());
+	for (size_t i = 0; i < str.size();)
+	{
+		uint32_t c = (uint8_t)str[i];
+		int extra = c < 0x80 ? 0 : (c >> 5) == 6 ? 1 : (c >> 4) == 14 ? 2 : (c >> 3) == 30 ? 3 : -1;
+		if (extra < 0 || i + extra >= str.size())
+		{
+			result += (wchar_t)0xfffd; // not valid UTF-8
+			i++;
+			continue;
+		}
+		if (extra == 1) c &= 0x1f;
+		else if (extra == 2) c &= 0x0f;
+		else if (extra == 3) c &= 0x07;
+		for (int k = 1; k <= extra; k++)
+			c = (c << 6) | ((uint8_t)str[i + k] & 0x3f);
+		i += extra + 1;
+		if (c >= 0x10000)
+		{
+			c -= 0x10000;
+			result += (wchar_t)(0xd800 + (c >> 10));
+			result += (wchar_t)(0xdc00 + (c & 0x3ff));
+		}
+		else
+		{
+			result += (wchar_t)c;
+		}
+	}
+	return result;
 }
 
 #endif
