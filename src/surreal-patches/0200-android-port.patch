+					outColor *= darkClamp(textureMacro(texCoord3));
+				}
+
+				if ((flags & 1u) != 0u) // Lightmap
+				{
+					outColor.rgb *= clamp(textureLightmap(texCoord2).rgb, 0.0, 1.0) * oneXBlending;
+				}
+
+				if ((flags & 4u) != 0u) // Detail texture
