+#elif defined __ANDROID__
+
+	// Android has no backtrace(): walk the stack with the unwinder and name the frames with dladdr
+	struct Walk
+	{
+		std::ostringstream* out;
+		int left;
+		int count;
+	} walk{ &sstream, maxframes, 0 };
+	_Unwind_Backtrace([](_Unwind_Context* context, void* arg) -> _Unwind_Reason_Code
+	{
+		Walk* w = static_cast<Walk*>(arg);
+		if (w->left <= 0)
+			return _URC_END_OF_STACK;
+		uintptr_t pc = _Unwind_GetIP(context);
+		if (pc == 0)
+			return _URC_END_OF_STACK;
+		Dl_info info;
+		if (dladdr(reinterpret_cast<void*>(pc), &info) && info.dli_sname)
+		{
+			int status = 0;
+			char* demangled = abi::__cxa_demangle(info.dli_sname, nullptr, nullptr, &status);
+			*w->out << "at " << (status == 0 && demangled ? demangled : info.dli_sname) << " + " << (pc - reinterpret_cast<uintptr_t>(info.dli_saddr)) << std::endl;
+			free(demangled);
+		}
+		else if (info.dli_fname)
+		{
+			*w->out << "at " << info.dli_fname << " +0x" << std::hex << (pc - reinterpret_cast<uintptr_t>(info.dli_fbase)) << std::dec << std::endl;
+		}
+		w->left--;
+		w->count++;
+		return _URC_NO_REASON;
+	}, &walk);
+	return walk.count;
+
 /////////////////////////////////////////////////////////////////////
 #else
 
