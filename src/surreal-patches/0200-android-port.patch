+					outColor.rgb = fogcolor.rgb + outColor.rgb * (1.0 - fogcolor.a);
+				}
+				else if ((flags & 16u) != 0u) // Fog color
+				{
+					vec4 fogcolor = vec4(texCoord2, texCoord3);
+					outColor.rgb = fogcolor.rgb + outColor.rgb * (1.0 - fogcolor.a);
+				}
