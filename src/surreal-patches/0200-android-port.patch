+		uint32_t c = (uint32_t)str[i] & 0xffff;
+		if (c >= 0xd800 && c < 0xdc00 && i + 1 < str.size())
+		{
+			uint32_t low = (uint32_t)str[i + 1] & 0xffff;
+			if (low >= 0xdc00 && low < 0xe000)
