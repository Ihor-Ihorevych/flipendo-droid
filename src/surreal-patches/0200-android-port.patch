+#ifdef __ANDROID__
+// The desktop shaders (GLSL 4.20) as GLSL ES 3.00, line by line. ES 3.00 has no binding qualifier (the sampler units are set
+// after linking, BindSamplerUnits), and layout(location) only on vertex inputs and fragment outputs: the varyings between
+// the stages match by name, which they do. "centroid" is dropped (no multisampling on Android; ES 3.00 drivers disagree on
+// whether it must match between the stages), and so is the scene's unused textureBinds input, which no vertex output feeds.
+static std::string ToGlslEs300(const std::string& source, bool vertex)
+{
+	std::string out;
+	size_t pos = 0;
+	while (pos < source.size())
+	{
+		size_t end = source.find('\n', pos);
+		if (end == std::string::npos)
+			end = source.size();
+		std::string line = source.substr(pos, end - pos);
+		pos = end + 1;
+
+		if (line.find("textureBinds") != std::string::npos && line.find(" in ") != std::string::npos)
+			continue;
+		size_t layout = line.find("layout(");
+		if (layout != std::string::npos)
+		{
+			size_t close = line.find(')', layout);
+			std::string qualifier = line.substr(layout, close - layout + 1);
+			bool binding = qualifier.find("binding") != std::string::npos;
+			bool varying = qualifier.find("location") != std::string::npos &&
+				(vertex ? line.find(" out ") != std::string::npos : line.find(" in ") != std::string::npos);
+			if (binding || varying)
+				line.erase(layout, close - layout + 2); // the qualifier and the space after it
+		}
+		size_t centroid = line.find("centroid ");
+		if (centroid != std::string::npos)
+			line.erase(centroid, 9);
+		out += line;
+		out += '\n';
+	}
+	return out;
+}
+
+// The sampler units the desktop shaders gave with layout(binding = N), set by name once the program is linked
+static void BindSamplerUnits(GLuint program)
+{
+	static const struct { const char* name; int unit; } units[] = {
+		{ "tex", 0 }, { "lightmap", 1 }, { "macro", 2 }, { "detail", 3 }, // Scene.frag
+		{ "texSampler", 0 }, { "texDither", 1 },                           // Present, bloom and blur
+	};
+	glUseProgram(program);
+	for (const auto& u : units)
+	{
+		GLint location = glGetUniformLocation(program, u.name);
+		if (location >= 0)
+			glUniform1i(location, u.unit);
+	}
+	glUseProgram(0);
+}
