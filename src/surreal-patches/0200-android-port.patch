+void DescriptorSetManager::CreateFixedTextureSets()
+{
+	FixedTextures.Layout = DescriptorSetLayoutBuilder()
+		.AddBinding(0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT)
+		.AddBinding(1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT)
+		.AddBinding(2, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT)
+		.AddBinding(3, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT)
+		.DebugName("FixedTextureLayout")
+		.Create(renderer->Device.get());
+
+	VkDescriptorPoolSize size = {};
+	size.type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+	size.descriptorCount = 4 * MaxFixedTextureSets;
+
+	VkDescriptorPoolCreateInfo info = { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+	info.maxSets = MaxFixedTextureSets;
+	info.poolSizeCount = 1;
+	info.pPoolSizes = &size;
+	VkResult result = vkCreateDescriptorPool(renderer->Device->device, &info, nullptr, &FixedTextures.Pool);
+	renderer->Device->CheckVulkanError(result, "Could not create the fixed texture descriptor pool");
+}
+
+VkDescriptorSet DescriptorSetManager::GetFixedTextureSet(const FixedTextureKey& key)
+{
+	auto it = FixedTextures.Cache.find(key);
+	if (it != FixedTextures.Cache.end())
+		return it->second;
+
+	VkDescriptorSetAllocateInfo alloc = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+	alloc.descriptorPool = FixedTextures.Pool;
+	alloc.descriptorSetCount = 1;
+	alloc.pSetLayouts = &FixedTextures.Layout->layout;
+	VkDescriptorSet set = VK_NULL_HANDLE;
+	VkResult result = vkAllocateDescriptorSets(renderer->Device->device, &alloc, &set);
+	renderer->Device->CheckVulkanError(result, "Could not allocate a texture descriptor set");
+
+	VkDescriptorImageInfo images[4] = {};
+	VkWriteDescriptorSet writes[4] = {};
+	for (int i = 0; i < 4; i++)
+	{
+		images[i].sampler = key.sampler[i];
+		images[i].imageView = key.view[i];
+		images[i].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+		writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+		writes[i].dstSet = set;
+		writes[i].dstBinding = (uint32_t)i;
+		writes[i].descriptorCount = 1;
+		writes[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+		writes[i].pImageInfo = &images[i];
+	}
+	vkUpdateDescriptorSets(renderer->Device->device, 4, writes, 0, nullptr);
+
+	FixedTextures.Cache[key] = set;
+	FixedTextures.Count++;
+	return set;
+}
+
+void DescriptorSetManager::ResetFixedTextureSets()
+{
+	if (FixedTextures.Pool == VK_NULL_HANDLE)
+		return;
+	vkResetDescriptorPool(renderer->Device->device, FixedTextures.Pool, 0);
+	FixedTextures.Cache.clear();
+	FixedTextures.Count = 0;
+}
