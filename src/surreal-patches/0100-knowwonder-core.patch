+// the message for a package that isn't in any [Core.System] Paths folder
+std::string PackageManager::MissingPackageMessage(const NameString& name, const NameString& neededBy) const
+{
+	std::string text = "Could not find package '" + name.ToString() + "'";
+	if (!neededBy.IsNone())
+		text += " (needed by package '" + neededBy.ToString() + "')";
+	text += ".\nPackages are looked up by name in the folders listed as Paths= under [Core.System] in the game's ini:\n";
+	for (const auto& [entry, folder] : searchPaths)
+		text += "  " + folder + "   (Paths=" + entry + ")" + (fs::exists(folder) ? "" : "   <- folder does not exist") + "\n";
+	text += "Check that the game is fully installed in " + gameRootFolderPath.string() + " (System, Maps, Textures, Sounds, Music).";
+	return text;
+}
