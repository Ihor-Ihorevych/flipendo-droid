+// A path from a script (HP2's "Cutscenes\00001PrivetIntro") uses backslashes and its own capitalisation; resolve it on case-sensitive
+// file systems too (Android): each component may differ from the real name in case only.
+static fs::path ResolveGamePath(const fs::path& root, std::string relative)
+{
+	std::replace(relative.begin(), relative.end(), '\\', '/');
+	fs::path result = root;
+	size_t pos = 0;
+	while (pos <= relative.size())
+	{
+		size_t end = relative.find('/', pos);
+		if (end == std::string::npos)
+			end = relative.size();
+		std::string part = relative.substr(pos, end - pos);
+		pos = end + 1;
+		if (part.empty())
+			continue;
+
+		fs::path candidate = result / part;
+		std::error_code error;
+		if (!fs::exists(candidate, error))
+		{
+			std::string wanted = part;
+			std::transform(wanted.begin(), wanted.end(), wanted.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+			for (const auto& entry : fs::directory_iterator(result, error))
+			{
+				std::string name = entry.path().filename().string();
+				std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+				if (name == wanted)
+				{
+					candidate = entry.path();
+					break;
+				}
+			}
+		}
+		result = candidate;
+	}
+	return result;
+}
