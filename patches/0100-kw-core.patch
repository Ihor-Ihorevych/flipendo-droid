+// flipendo: input alias names are matched ignoring case, as in UE1. HP1's options menu rebinds keys with
+// upper-cased aliases ("SET Input W MOVEFORWARD | BUTTON BBROOMPITCHUP"), which never matched "MoveForward".
+static std::string ToLowerAlias(std::string name)
+{
+	for (char& c : name) c = std::tolower((unsigned char)c);
+	return name;
+}
