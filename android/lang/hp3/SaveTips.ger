[hp3_portraitpassword_e]
Line0=Um den vollständigen Satz Karten zu sammeln, erkunde die Schule und ihre Ländereien, spiel die Zauberherausforderungen, besuche den Laden von Fred und George und sprich mit den anderen Schülern.
Picture0=Picture_25
Count=1
